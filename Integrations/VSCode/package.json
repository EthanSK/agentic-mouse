{
  "name": "agentic-mouse-vscode-bridge",
  "displayName": "Agentic Mouse VS Code Bridge",
  "description": "Executes the small, allow-listed set of VS Code commands requested by Agentic Mouse.",
  "version": "0.1.2",
  "publisher": "ethansk",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "vscode": "^1.83.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onUri",
    "onCommand:agenticMouse.replacePeekDefinition"
  ],
  "contributes": {
    "keybindings": [
      {
        "key": "ctrl+alt+cmd+f12",
        "mac": "ctrl+alt+cmd+f12",
        "command": "agenticMouse.replacePeekDefinition",
        "when": "isMac && editorTextFocus && editorHasDefinitionProvider && !isInEmbeddedEditor && !referenceSearchVisible",
        "args": { "replace": false }
      },
      {
        "key": "ctrl+alt+cmd+f12",
        "mac": "ctrl+alt+cmd+f12",
        "command": "agenticMouse.replacePeekDefinition",
        "when": "isMac && editorTextFocus && editorHasDefinitionProvider && referenceSearchVisible && !isInEmbeddedEditor && !isInDiffEditor"
      },
      {
        "key": "ctrl+alt+cmd+f12",
        "mac": "ctrl+alt+cmd+f12",
        "command": "agenticMouse.replacePeekDefinition",
        "when": "isMac && editorTextFocus && editorHasDefinitionProvider && referenceSearchVisible && !isInEmbeddedEditor && isInDiffEditor && isInDiffLeftEditor",
        "args": {
          "diffSide": "original"
        }
      },
      {
        "key": "ctrl+alt+cmd+f12",
        "mac": "ctrl+alt+cmd+f12",
        "command": "agenticMouse.replacePeekDefinition",
        "when": "isMac && editorTextFocus && editorHasDefinitionProvider && referenceSearchVisible && !isInEmbeddedEditor && isInDiffEditor && !isInDiffLeftEditor",
        "args": {
          "diffSide": "modified"
        }
      }
    ]
  },
  "main": "./extension.js",
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/EthanSK/agentic-mouse"
  },
  "devDependencies": {
    "@vscode/vsce": "3.9.2"
  }
}
