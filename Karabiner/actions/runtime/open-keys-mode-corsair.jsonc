// Opens the shared Keys mode directly from Corsair physical cell 9.
{
  "id": "open-keys-mode-corsair",
  "title": "Open Keys mode (Corsair)",
  "description": "Send one exact-device Corsair Keys mode request to Agentic Mouse.",
  "manipulator": {
    "to": [{
      "send_user_command": {
        "payload": {
          "command": "agentic_mouse_mode_picker",
          "action": "openKeys",
          "source": "corsair",
          "physical_cell": 9,
          "phase": "press"
        }
      },
      "repeat": false
    }]
  }
}
