// Opens the frontmost app's Agentic Mouse mode directly from Razer physical cell 2 (printed 2).
{
  "id": "open-app-specific-mode-razer",
  "title": "Open app-specific mode (Razer)",
  "description": "Send one exact-device Razer app-specific mode request to Agentic Mouse.",
  "manipulator": {
    "to": [{
      "send_user_command": {
        "payload": {
          "command": "agentic_mouse_mode_picker",
          "action": "openAppSpecific",
          "source": "razer",
          "physical_cell": 2,
          "phase": "press"
        }
      },
      "repeat": false
    }]
  }
}
