// Toggles the persistent top-level legend when tapped; acts as Command while held.
{
  "id": "toggle-default-map-hint-razer",
  "title": "Toggle Default mode legend / hold Command (Razer)",
  "description": "Tap to toggle the Razer legend; hold as a lazy Command modifier.",
  "manipulator": {
    "to": [{
      "key_code": "left_command",
      "lazy": true
    }],
    "to_if_alone": [{
      "send_user_command": {
        "payload": {
          "command": "agentic_mouse_default_map_toggle",
          "source": "razer",
          "physical_cell": 10
        }
      },
      "repeat": false
    }],
    "parameters": {
      "basic.to_if_alone_timeout_milliseconds": 300
    }
  }
}
