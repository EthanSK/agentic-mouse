// Toggles the persistent top-level legend from shared physical cell 10 (Razer printed 12).
{
  "id": "toggle-default-map-hint-razer",
  "title": "Toggle Default mode legend (Razer)",
  "description": "Send one exact-device Razer legend toggle to Agentic Mouse.",
  "manipulator": {
    "to": [{
      "send_user_command": {
        "payload": {
          "command": "agentic_mouse_default_map_toggle",
          "source": "razer",
          "physical_cell": 10
        }
      },
      "repeat": false
    }]
  }
}
