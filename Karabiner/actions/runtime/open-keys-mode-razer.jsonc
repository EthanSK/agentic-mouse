// Opens the shared Keys mode directly from Razer physical cell 9 (printed 7).
{
  "id": "open-keys-mode-razer",
  "title": "Open Keys mode (Razer)",
  "description": "Send one exact-device Razer Keys mode request to Agentic Mouse.",
  "manipulator": {
    "to": [{
      "send_user_command": {
        "payload": {
          "command": "agentic_mouse_mode_picker",
          "action": "openKeys",
          "source": "razer",
          "physical_cell": 9,
          "phase": "press"
        }
      },
      "repeat": false
    }]
  }
}
