// Click captures or cancels; hold and wheel down pastes the saved screenshot.
{
  "id": "toggle-selected-screen-area-razer",
  "title": "Screenshot and wheel paste (Razer)",
  "description": "Click to capture or cancel; hold and wheel down to paste the last saved screenshot.",
  "manipulator": {
    "to": [
      {
        "send_user_command": {
          "payload": {
            "command": "agentic_mouse_wheel_chord",
            "source": "razer",
              "control": "screenshotPaste",
            "phase": "press"
          }
        },
        "repeat": false
      }
    ],
    "to_after_key_up": [
      {
        "send_user_command": {
          "payload": {
            "command": "agentic_mouse_wheel_chord",
            "source": "razer",
              "control": "screenshotPaste",
            "phase": "release"
          }
        },
        "repeat": false
      }
    ]
  }
}
