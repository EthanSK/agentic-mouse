// Holds the top-level YouTube scrub chord on Corsair physical cell 6.
{
  "id": "hold-youtube-scrub-wheel-corsair",
  "title": "YouTube Scrub + Wheel (Corsair)",
  "description": "Arm Agentic Mouse while Corsair physical cell 6 is held; release always disarms it.",
  "manipulator": {
    "to": [{
      "send_user_command": {
        "payload": {
          "command": "agentic_mouse_wheel_chord",
          "control": "youtubeScrub",
          "source": "corsair",
          "phase": "press"
        }
      },
      "repeat": false
    }],
    "to_after_key_up": [{
      "send_user_command": {
        "payload": {
          "command": "agentic_mouse_wheel_chord",
          "control": "youtubeScrub",
          "source": "corsair",
          "phase": "release"
        }
      },
      "repeat": false
    }]
  }
}
