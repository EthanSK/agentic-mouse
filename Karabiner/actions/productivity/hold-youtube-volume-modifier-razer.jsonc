// Classifies Razer physical cell 5 as ordinary Forward unless a same-source cell-6 wheel hold uses YouTube volume.
{
  "id": "hold-youtube-volume-modifier-razer",
  "title": "Forward / YouTube Volume modifier (Razer)",
  "description": "Track Razer physical cell 5 until release so Agentic Mouse can suppress Forward only after a 6+5 YouTube volume ratchet.",
  "manipulator": {
    "to": [{
      "send_user_command": {
        "payload": {
          "command": "agentic_mouse_youtube_volume_modifier",
          "source": "razer",
          "phase": "press"
        }
      },
      "repeat": false
    }],
    "to_after_key_up": [{
      "send_user_command": {
        "payload": {
          "command": "agentic_mouse_youtube_volume_modifier",
          "source": "razer",
          "phase": "release"
        }
      },
      "repeat": false
    }]
  }
}
