// Opens macOS App Switcher once, then keeps Command held until the physical trigger is released; physical acceptance is still required.
{
  "id": "hold-open-app-switcher",
  "title": "Hold open App Switcher",
  "description": "Open the native macOS App Switcher, keep it available for selection while held, and commit the highlighted app on release.",
  "manipulator": {
    "to": [
      {
        "key_code": "tab",
        "modifiers": ["left_command"],
        "repeat": false
      },
      {
        "key_code": "left_command",
        "repeat": true
      }
    ]
  }
}
