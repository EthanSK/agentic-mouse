// In Visual Studio Code, emits F17 on physical release unless consumed, then keeps Stage + Previous available for one second.
{
  "id": "vscode-go-to-previous-change",
  "title": "VS Code: go to previous change",
  "description": "Press marks the exact mouse's Previous button held; release emits F17 only when the same hold was not consumed, then starts that mouse's one-second Copy / Paste staging window.",
  "manipulator": {
    "conditions": [
      { "type": "frontmost_application_if", "bundle_identifiers": ["^com\\.microsoft\\.VSCode(?:Insiders)?$"] }
    ],
    "to": [
      { "set_variable": { "name": "$binding_variable", "value": 1 } }
    ],
    "to_after_key_up": [
      { "key_code": "f17", "repeat": false, "conditions": [{ "type": "variable_if", "name": "$binding_variable", "value": 1 }] },
      { "set_variable": { "name": "$binding_variable", "expression": "system.now.milliseconds + 1000" } }
    ]
  }
}
