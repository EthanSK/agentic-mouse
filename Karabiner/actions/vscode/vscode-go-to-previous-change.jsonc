// In Visual Studio Code, emits F17 on physical release for the existing Better Git Previous Change keybinding.
{
  "id": "vscode-go-to-previous-change",
  "title": "VS Code: go to previous change",
  "description": "Release moves to the previous change with one non-repeating F17 event and no double-click decision window.",
  "manipulator": {
    "conditions": [
      { "type": "frontmost_application_if", "bundle_identifiers": ["^com\\.microsoft\\.VSCode(?:Insiders)?$"] }
    ],
    "to_after_key_up": [
      { "key_code": "f17", "repeat": false }
    ]
  }
}
