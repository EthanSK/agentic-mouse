// In Visual Studio Code, Corsair physical cell 4 stages backward while cell 5 is held or for one second after cell 5 releases.
{
  "id": "vscode-stage-previous-while-corsair-previous-held",
  "title": "VS Code: stage and go previous while Corsair Previous is held",
  "description": "Consumes Corsair physical cell 4 as ordinary F19 while cell 5 is held, or source-tagged F19 to stage its pre-navigation file during the one-second post-release window.",
  "manipulators": [
    {
      "conditions": [
        { "type": "variable_if", "name": "agentic_mouse_corsair_vscode_side_05_previous_change_pending", "value": 1 },
        { "type": "frontmost_application_if", "bundle_identifiers": ["^com\\.microsoft\\.VSCode(?:Insiders)?$"] }
      ],
      "to": [
        { "set_variable": { "name": "agentic_mouse_corsair_vscode_side_05_previous_change_pending", "value": 2 } },
        { "key_code": "f19", "repeat": false }
      ]
    },
    {
      "conditions": [
        { "type": "expression_if", "expression": "(agentic_mouse_corsair_vscode_side_05_previous_change_pending > system.now.milliseconds) and (agentic_mouse_corsair_vscode_side_05_previous_change_pending <= system.now.milliseconds + 1000)" },
        { "type": "frontmost_application_if", "bundle_identifiers": ["^com\\.microsoft\\.VSCode(?:Insiders)?$"] }
      ],
      "to": [
        { "set_variable": { "name": "agentic_mouse_corsair_vscode_side_05_previous_change_pending", "value": 0 } },
        { "key_code": "f19", "modifiers": ["left_control", "left_option", "left_command"], "repeat": false }
      ]
    }
  ]
}
