// In Visual Studio Code, emits F13 on physical release unless the held button is consumed by Stage + Next.
{
  "id": "vscode-go-to-next-change",
  "title": "VS Code: go to next change",
  "description": "Press marks the exact mouse's Next button held; release emits F13 only when the same hold was not consumed by the Stage + Next chord.",
  "manipulator": {
    "conditions": [
      { "type": "frontmost_application_if", "bundle_identifiers": ["^com\\.microsoft\\.VSCode(?:Insiders)?$"] }
    ],
    "to": [
      { "set_variable": { "name": "$binding_variable", "value": 1 } }
    ],
    "to_after_key_up": [
      { "key_code": "f13", "repeat": false, "conditions": [{ "type": "variable_if", "name": "$binding_variable", "value": 1 }] },
      { "set_variable": { "name": "$binding_variable", "value": 0 } }
    ]
  }
}
