    {
      "id": "hold-open-app-switcher",
      "title": "Hold open App Switcher",
      "description": "Open the native macOS App Switcher, keep it available for selection while held, and commit the highlighted app on release.",
      "source": "app-switching/hold-open-app-switcher.jsonc",
      "manipulator": {
        "to": [
          {
            "key_code": "tab",
            "modifiers": [
              "left_command"
            ],
            "repeat": false
          },
          {
            "key_code": "left_command",
            "repeat": true
          }
        ]
      }
    },
    {
      "id": "open-app-specific-mode-corsair",
      "title": "Open app-specific mode (Corsair)",
      "description": "Send one exact-device Corsair app-specific mode request to Agentic Mouse.",
      "source": "runtime/open-app-specific-mode-corsair.jsonc",
      "manipulator": {
        "to": [
          {
            "send_user_command": {
              "payload": {
                "command": "agentic_mouse_mode_picker",
                "action": "openAppSpecific",
                "source": "corsair",
                "physical_cell": 6,
                "phase": "press"
              }
            },
            "repeat": false
          }
        ]
      }
    },
    {
      "id": "open-app-specific-mode-razer",
