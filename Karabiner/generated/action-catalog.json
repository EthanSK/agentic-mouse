    {
      "id": "go-back",
      "title": "Go back",
      "description": "Use ordinary Back navigation without app-specific source-control interception.",
      "source": "navigation/go-back.jsonc",
      "manipulator": {
        "to": [
          {
            "pointing_button": "button4"
          }
        ]
      }
    },
    {
      "id": "go-forward",
      "title": "Go forward",
      "description": "Use ordinary Forward navigation without app-specific source-control interception.",
